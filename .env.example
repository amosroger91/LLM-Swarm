# Copy to .env for local experiments. Never commit real values.
# The swarm reads these names from the process environment. It does not store them.
# A provider whose key is missing is marked unavailable and its failover chain moves on.

# Optional. Ollama's OpenAI-compatible endpoint usually accepts requests with no key.
OLLAMA_API_KEY=

# Free-tier execution fallbacks used by config/hybrid.yaml.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional for the Claude Code planner. Without it, `claude` uses its own saved login.
ANTHROPIC_API_KEY=

# Used only if a CLI profile lists them in envPass.
XAI_API_KEY=
OPENAI_API_KEY=

# Optional path to the YAML config. CLI --config wins over this variable.
SWARM_CONFIG=
